v\_box = QVBoxLayout()

v\_box.addWidget(label)

v\_box.addWidget(normal\_button)

v\_box.addWidget(warning\_button)

self.setLayout(v\_box)

self.show()

if \_\_name\_\_ == '\_\_main\_\_':

app = QApplication(sys.argv)

app.setStyleSheet(style\_sheet) # Set style of application

window = MainWindow()

sys.exit(app.exec())

